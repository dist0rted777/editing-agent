{
  "name": "@editing-agent/studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "benchmark": "remotion benchmark",
    "render:draft": "remotion render MainComposition ../../out/draft.mp4 --scale=0.5 --image-format=jpeg",
    "render:final": "remotion render MainComposition ../../out/final.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@editing-agent/registry": "workspace:*",
    "@editing-agent/schema": "workspace:*",
    "@remotion/cli": "^4.0.0",
    "@remotion/media": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12"
  }
}
